{
  "name": "git-time-lapse",
  "version": "1.1.0",
  "description": "Git Time-Lapse View v1.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amd/git-time-lapse"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:v1": "vite --mode v1",
    "build": "npm run build:v2",
    "build:v2": "tsc && vite build --mode v2",
    "build:v1": "tsc -p tsconfig.v1.json && vite build --mode v1",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:v1": "cd src-tauri-v1 && node ../node_modules/@tauri-apps/cli-v1/tauri.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/api-v1": "npm:@tauri-apps/api@^1.6.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@tauri-apps/cli-v1": "npm:@tauri-apps/cli@^1.6.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3"
  }
}
