{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Time-Lapse View v1.1.0",
  "version": "1.1.0",
  "identifier": "com.amd.gittimelapse",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:v2"
  },
  "app": {
    "windows": [
      {
        "title": "Git Time-Lapse View v1.1.0",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Advanced Micro Devices, Inc.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
