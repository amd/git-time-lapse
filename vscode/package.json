{
  "name": "git-time-lapse-vscode",
  "displayName": "Git Time-Lapse View v1.1.0",
  "description": "Git Time-Lapse View v1.1.0 — visual time-lapse viewer for file history in git repositories",
  "version": "1.1.0",
  "publisher": "AMD",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amd/git-time-lapse"
  },
  "homepage": "https://github.com/amd/git-time-lapse#readme",
  "bugs": {
    "url": "https://github.com/amd/git-time-lapse/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-time-lapse.open",
        "title": "Git Time-Lapse: Open"
      },
      {
        "command": "git-time-lapse.openFile",
        "title": "Open Time-Lapse View"
      },
      {
        "command": "git-time-lapse.openFileAtLine",
        "title": "Open Time-Lapse View"
      },
      {
        "command": "git-time-lapse.openRepo",
        "title": "Open Time-Lapse View (Repository)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "git-time-lapse.openFileAtLine",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "git-time-lapse.openFile",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "navigation@100"
        },
        {
          "command": "git-time-lapse.openRepo",
          "when": "explorerResourceIsFolder && resourceScheme == file",
          "group": "navigation@100"
        }
      ],
      "editor/title/context": [
        {
          "command": "git-time-lapse.openFile",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "command": "git-time-lapse.openFileAtLine",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        }
      ]
    }
  },
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "css-loader": "^6.10.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "highlight.js": "^11.9.0"
  }
}
